{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperdustlabs.github.io/OpenCOAT/schemas/concern.schema.json",
  "title": "Concern",
  "description": "First-class runtime unit. The runtime only distinguishes kind=concern|meta_concern; semantic types live in generated_type/generated_tags. Strict shape (no extra properties) is enforced by the pydantic envelope; the schema is intentionally extensible so MetaConcern can layer on top.",
  "type": "object",
  "required": ["id", "kind", "name", "schema_version"],
  "properties": {
    "id":              { "type": "string", "minLength": 1 },
    "kind":            { "type": "string", "enum": ["concern", "meta_concern"] },
    "generated_type":  { "type": "string" },
    "generated_tags":  { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
    "name":            { "type": "string", "minLength": 1 },
    "description":     { "type": "string", "default": "" },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "user_input", "tool_result", "memory", "feedback",
            "host_explicit_plan", "draft_output", "environment_event",
            "system_default", "manual_import", "derived"
          ]
        },
        "ref":           { "type": "string" },
        "ts":            { "type": "string", "format": "date-time" },
        "trust":         { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },

    "chain_ref": {
      "type": "object",
      "description": "Optional pointer to an external on-chain or content-addressed reference for this concern. Schema-only placeholder; the runtime never interprets this field. Reserved for future MOSSAI / L3 transports — see docs/07-mvp/post-m5-roadmap.md §6.",
      "additionalProperties": false,
      "required": ["network", "ref"],
      "properties": {
        "network":     { "type": "string", "minLength": 1 },
        "ref":         { "type": "string", "minLength": 1 },
        "content_uri": { "type": "string", "minLength": 1 }
      }
    },

    "joinpoint_selectors": {
      "type": "array",
      "items": { "$ref": "joinpoint.schema.json#/$defs/JoinpointSelector" },
      "default": []
    },
    "pointcut":        { "$ref": "pointcut.schema.json" },
    "advice":          { "$ref": "advice.schema.json" },
    "weaving_policy":  { "$ref": "weaving.schema.json#/$defs/WeavingPolicy" },

    "pointcuts": {
      "type": "array",
      "description": "AOP (AspectJ) pointcuts (ADR-0010). Legacy pointcut syncs to pointcuts[0].",
      "items": { "$ref": "#/$defs/PointcutDef" },
      "default": []
    },
    "advices": {
      "type": "array",
      "description": "AOP advices (before/after/around + effect).",
      "items": { "$ref": "#/$defs/AopAdvice" },
      "default": []
    },
    "declarations": {
      "type": "array",
      "description": "declare precedence | inter-type declarations.",
      "items": { "$ref": "#/$defs/ConcernDeclaration" },
      "default": []
    },
    "graph_edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/ConcernGraphEdge" },
      "default": []
    },

    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crosscutting":        { "type": "boolean", "default": false },
        "duration":            { "type": "string", "enum": ["transient", "turn", "session", "long_term"], "default": "turn" },
        "joinpoint_coverage":  { "type": "array", "items": { "type": "string" }, "default": [] },
        "tenant_id":           { "type": "string" },
        "agent_session_id":    { "type": "string" }
      }
    },

    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_concern_id", "relation_type"],
        "properties": {
          "target_concern_id": { "type": "string" },
          "relation_type": {
            "type": "string",
            "enum": [
              "activates", "suppresses", "constrains", "verifies",
              "conflicts_with", "depends_on", "generalizes", "specializes",
              "duplicates", "derived_from", "updates", "replaces", "supports",
              "declares_precedence_over"
            ]
          },
          "layer": {
            "type": "string",
            "enum": ["runtime", "semantic"],
            "default": "semantic"
          },
          "weight":  { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "default": []
    },

    "activation_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active":             { "type": "boolean", "default": false },
        "score":              { "type": "number", "minimum": 0, "maximum": 1 },
        "last_activated_at":  { "type": "string", "format": "date-time" },
        "decay":              { "type": "number", "minimum": 0, "default": 0 }
      }
    },

    "lifecycle_state": {
      "type": "string",
      "enum": [
        "created", "active", "reinforced", "weakened",
        "merged", "frozen", "archived", "deleted", "revived"
      ],
      "default": "created"
    },

    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activations":  { "type": "integer", "minimum": 0, "default": 0 },
        "satisfied":    { "type": "integer", "minimum": 0, "default": 0 },
        "violated":     { "type": "integer", "minimum": 0, "default": 0 },
        "tokens_used":  { "type": "integer", "minimum": 0, "default": 0 }
      }
    },

    "created_at":  { "type": "string", "format": "date-time" },
    "updated_at":  { "type": "string", "format": "date-time" },
    "schema_version": { "type": "string", "default": "0.1.0" }
  },
  "$defs": {
    "PointcutDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "default": "pc-default" },
        "expression": { "type": "string", "description": "AOP (AspectJ) surface syntax, e.g. user_message() && args(\"rm -rf\")" },
        "joinpoints": { "$ref": "pointcut.schema.json#/properties/joinpoints" },
        "match": { "$ref": "pointcut.schema.json#/properties/match" },
        "context_predicates": { "$ref": "pointcut.schema.json#/properties/context_predicates" }
      }
    },
    "AopAdvice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "content"],
      "properties": {
        "id": { "type": "string", "default": "adv-default" },
        "kind": { "type": "string", "enum": ["before", "after", "around", "after_returning", "after_throwing"] },
        "pointcut_ref": { "type": "string", "default": "pc-default" },
        "content": { "type": "string", "minLength": 1 },
        "template": { "$ref": "advice.schema.json#/properties/type" },
        "rationale": { "type": "string" },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "params": { "type": "object" },
        "effect": { "$ref": "weaving.schema.json#/$defs/WeavingPolicy" }
      }
    },
    "DeclarePrecedence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "order"],
      "properties": {
        "kind": { "const": "declare_precedence" },
        "order": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "InterTypeDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "const": "inter_type" },
        "target": { "type": "string" },
        "introduces": { "type": "object" }
      }
    },
    "ConcernDeclaration": {
      "oneOf": [
        { "$ref": "#/$defs/DeclarePrecedence" },
        { "$ref": "#/$defs/InterTypeDeclaration" }
      ]
    },
    "ConcernGraphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_type", "from_id", "to_id"],
      "properties": {
        "edge_type": {
          "type": "string",
          "enum": [
            "defines", "selects", "owns", "runs_at", "binds",
            "declares_precedence_over", "introduces", "advises", "advice_execution"
          ]
        },
        "from_id": { "type": "string" },
        "to_id": { "type": "string" },
        "weight": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 }
      }
    }
  }
}
